# Inventory U3 — environment template
#
# Copy to `.env` (git-ignored) and adjust. Every variable is validated with Zod
# at startup by apps/api (see apps/api/src/config/env.ts) — the process refuses
# to boot with a missing or malformed value.

# ─── Shared ────────────────────────────────────────────────────────────────
NODE_ENV=development
# The organization this API process serves. Must match an `organizations.id`
# row. `pnpm run db:seed` creates this one.
ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
# How long a session stays valid, in hours (1–720).
SESSION_TTL_HOURS=12
# Failed sign-in attempts allowed per email and client address before login
# answers 429.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15

# ─── API (apps/api) ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3010
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Database ─────────────────────────────────────────────────────────────
# SQLite by default (ADR 0025): a relative url resolves against the repository
# root; run `pnpm run db:migrate` and `pnpm run db:seed` once to create the file.
# PostgreSQL stays a supported second engine: point the url below at a running
# instance instead.
DATABASE_URL=sqlite:./data/inventory-u3.db
# Used by pnpm run test:integration — PostgreSQL only; tests never touch the
# development database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/inventory_u3_test

# ─── Web app (apps/web) ───────────────────────────────────────────────────
# Must include the version prefix: ApiClient concatenates paths onto this
# value verbatim, and every route lives under /api/v1.
VITE_API_URL=http://localhost:3010/api/v1

# ─── Desktop app (apps/desktop) ──────────────────────────────────────────
# A desktop build may point at a different backend.
VITE_API_URL_DESKTOP=http://localhost:3010/api/v1
